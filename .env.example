# Copy jadi .env lalu isi. JANGAN commit .env ke git.
NETID=nim@it.student.pens.ac.id
PASSWORD=ganti_password_ethol

# Nomor tujuan WA (format 628xxx, tanpa + atau @s.whatsapp.net)
WA_TARGET=628xxxxxxxxxx

# Baileys gateway (service wa-gateway di docker-compose)
WA_GATEWAY_URL=http://wa-gateway:3000
# kosongkan jika tidak pakai auth, atau isi string acak dan samakan di docker-compose
WA_GATEWAY_API_KEY=

# Fallback Evolution (kalau WA_GATEWAY_URL dikosongkan)
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCE=absensi-notifier
EVOLUTION_API_KEY=ganti_dengan_openssl_rand_hex_32

# Filter notifikasi: kosong = semua (PRESENSI, TUGAS, PENGUMUMAN), atau misal PRESENSI-KULIAH,TUGAS-BARU
KODE_YANG_DIPANTAU=
POLL_INTERVAL_SECONDS=180

# Test pertama: kirim 1 notifikasi terbaru hari ini saat pertama jalan (untuk verifikasi WA)
# true = kirim 1 chat test, false = diam (hanya simpan baseline)
SEND_FIRST_RUN_TEST=true

# Level log: INFO (ringkas) atau DEBUG (JSON lengkap)
LOG_LEVEL=INFO
