# Copy jadi .env lalu isi. JANGAN commit .env ke git.
NETID=nim@it.student.pens.ac.id
PASSWORD=ganti_password_ethol

# Nomor tujuan WA: bisa personal (628xxx) ATAU grup (120363xxxx@g.us)
# Untuk grup: lihat cara ambil ID di README -> curl http://localhost:3000/groups
WA_TARGET=628xxxxxxxxxx
# contoh grup: 120363123456789012@g.us

# Baileys gateway (service wa-gateway di docker-compose)
WA_GATEWAY_URL=http://wa-gateway:3000
# kosongkan jika tidak pakai auth, atau isi string acak dan samakan di docker-compose
WA_GATEWAY_API_KEY=

# Fallback Evolution (kalau WA_GATEWAY_URL dikosongkan)
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCE=absensi-notifier
EVOLUTION_API_KEY=ganti_dengan_openssl_rand_hex_32

# Filter notifikasi: kosong = semua (PRESENSI, TUGAS, PENGUMUMAN), atau misal PRESENSI-KULIAH,TUGAS-BARU
KODE_YANG_DIPANTAU=
POLL_INTERVAL_SECONDS=180

# Test pertama: kirim 2-3 notifikasi terbaru hari ini saat pertama jalan (untuk verifikasi WA)
# true = kirim chat test, false = diam (hanya simpan baseline)
SEND_FIRST_RUN_TEST=true
SEND_FIRST_RUN_TEST_COUNT=3  # 2 atau 3 untuk testing multi chat

# Auto presensi: otomatis absen saat PRESENSI-KULIAH muncul (butuh key dari API)
# false = hanya notif WA, true = coba auto POST /api/presensi/mahasiswa + WA status
AUTO_PRESENSI=false

# Notifikasi error ke WA (jika terkena 403/429, proxy down, login gagal beruntun)
WA_NOTIFY_ERROR=true
WA_NOTIFY_ERROR_COOLDOWN=3600  # detik, anti spam (1 jam sekali)

# Level log: INFO (ringkas) atau DEBUG (JSON lengkap)
LOG_LEVEL=INFO

# ── Ganti IP Otomatis (opsional, aktifkan HANYA kalau ke-block 403/429) ──
# Default TANPA proxy/VPN sudah paling aman. Pilih SALAH SATU:

# OPSI 1: ProtonVPN GRATIS + ROTATE OTOMATIS (REKOMENDASI — stabil & gratis)
# Daftar di protonvpn.com (free) -> Account -> OpenVPN/IKEv2 -> Copy Username & Password
# Username biasanya seperti: xxxxxxxx (bukan email)
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
SERVER_COUNTRIES=Netherlands, Singapore, United States  # akan dipilih random tiap restart
FREE_ONLY=on
HTTP_PROXY=http://gluetun:8888
# Jalankan: docker compose --profile vpn up -d
# Auto ganti IP tiap jam: crontab -e -> 0 * * * * docker restart gluetun
# Ganti manual: docker restart gluetun && curl --proxy http://localhost:8888 https://ifconfig.me

# OPSI 2: WireGuard custom single endpoint (tidak rotate, 1 IP tetap)
# VPN_SERVICE_PROVIDER=custom
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=10.2.0.2/32
# WIREGUARD_PUBLIC_KEY=
# WIREGUARD_ENDPOINT_IP=
# WIREGUARD_ENDPOINT_PORT=51820
# HTTP_PROXY=http://gluetun:8888

# OPSI 3: Windscribe GRATIS 10GB
# VPN_SERVICE_PROVIDER=windscribe
# VPN_TYPE=openvpn
# OPENVPN_USER=windscribe_username
# OPENVPN_PASSWORD=windscribe_password
# SERVER_COUNTRIES=Singapore
# HTTP_PROXY=http://gluetun:8888

# OPSI 4: Tor GRATIS tanpa daftar (lambat & sering di-block)
# docker compose --profile tor up -d
# HTTP_PROXY=socks5://tor:9050

# Tanpa proxy/VPN (default aman):
# HTTP_PROXY=
# Kosongkan VPN_* di atas
